[Unit]
Description=Backup diário dos bancos do FazendaWEB
After=network-online.target fazendaweb.service
Wants=network-online.target

[Service]
Type=oneshot
User=fazendaweb
Group=fazendaweb
WorkingDirectory=/opt/fazendaweb/app
EnvironmentFile=/etc/fazendaweb/fazendaweb.env
ExecStart=/opt/fazendaweb/venv/bin/python /opt/fazendaweb/app/backups.py backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fazendaweb
