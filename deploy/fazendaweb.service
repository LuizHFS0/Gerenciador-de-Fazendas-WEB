[Unit]
Description=FazendaWEB FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fazendaweb
Group=fazendaweb
WorkingDirectory=/opt/fazendaweb/app
EnvironmentFile=/etc/fazendaweb/fazendaweb.env
ExecStart=/opt/fazendaweb/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fazendaweb

[Install]
WantedBy=multi-user.target
